# Copia este archivo a .env.local y rellena con TUS propios valores.
# Nunca subas .env, .env.local ni .env.*.local a GitHub.
# Solo .env.example se versiona.

# Configuración pública de Cognito para la SPA (no son secretos, pero no
# pongas claves AWS, client secrets, contraseñas, tokens ni banderas aquí).
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=TU_USER_POOL_ID
VITE_COGNITO_CLIENT_ID=TU_CLIENT_ID
VITE_COGNITO_DOMAIN=https://TU_DOMINIO.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# URL base del HTTP API desplegado (sin barra final).
VITE_API_URL=https://TU_API_ID.execute-api.us-east-1.amazonaws.com/prod
