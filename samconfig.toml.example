version = 0.1

[default.deploy.parameters]
stack_name = "reto-ciber-lab"
region = "us-east-1"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
parameter_overrides = "TableName=reto-ciber-2026 UserPoolId=TU_USER_POOL_ID ClientId=TU_CLIENT_ID AppOrigin=http://localhost:5173 LabMode=true ChallengeId=reto-ciber-2026"
